'use client'
import { useState } from 'react'
import ProdutoFormModal from '@/components/admin/ProdutoFormModal'
import SaboresConfigTab from '@/components/admin/SaboresConfigTab'
const ordinary = {id:'pizza',nome:'Pizza Teste',preco:30,categoria_id:'cat'}
export default function Validation() {
 const [open,setOpen] = useState(false)
 const [saved,setSaved] = useState(0)
 const [mode,setMode] = useState('ordinary')
 return <main>
 <select aria-label="Fixture" value={mode} onChange={e=>setMode(e.target.value)}><option>ordinary</option><option>configured</option><option>settings</option></select>
 <button onClick={()=>setOpen(true)}>Open product</button>
 <div data-testid="saved">{saved}</div>
 {mode==='settings'?<SaboresConfigTab/>:open&&<ProdutoFormModal produto={mode==='configured'?{...ordinary,sabores_grupo_id:'sabores',sabores_maximo:3}:ordinary} categorias={[{id:'cat',nome:'Pizzas'}]} onClose={()=>setOpen(false)} onSaved={()=>setSaved(n=>n+1)}/>}
 </main>
}